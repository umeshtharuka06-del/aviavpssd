# ─────────────────────────────────────────────────────────────────────────────
# VPS production environment — PLACEHOLDERS ONLY. Lists every variable docker-compose.yml uses.
#   Portainer (Git repository stack): enter these NAMES under the stack's "Environment variables".
#     No .env file is needed on the server or in Git.
#   Plain docker compose: cp .env.example .env && chmod 600 .env  (or: bash ../scripts/generate-secrets.sh)
# Never commit real values. Never copy them into the extension or the admin site.
# Generate each secret separately with:  openssl rand -hex 32
#   (hex avoids characters such as @ : / $ that break DATABASE_URL or Compose interpolation)
# ─────────────────────────────────────────────────────────────────────────────

# Public hostname of the API (DNS A/AAAA record → this VPS). Caddy obtains the TLS certificate.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# PostgreSQL (private Docker network only). The host in DATABASE_URL is the compose service name
# "postgres" and the port is 5432; user, password and database must match the three lines above it.
POSTGRES_DB=aviator
POSTGRES_USER=aviator_app
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://aviator_app:change-me-postgres-password@postgres:5432/aviator

# Four DIFFERENT random secrets (>= 32 chars each): openssl rand -hex 32
CODE_PEPPER=change-me-code-pepper
DEVICE_PEPPER=change-me-device-pepper
IP_HASH_PEPPER=change-me-ip-pepper
# Also set on Vercel as VPS_ADMIN_SERVICE_KEY (server-side env var, never NEXT_PUBLIC_).
ADMIN_SERVICE_KEY=change-me-admin-service-key

LOG_LEVEL=info
DATABASE_POOL_MAX=10
DEFAULT_DEVICE_LIMIT=5
CUSTOMER_SESSION_TTL_HOURS=168
ADMIN_SESSION_TTL_HOURS=8
# Comma-separated site keys, or * to accept any site found by the extension's generic detection.
ACCEPTED_SITE_IDS=onexbet,melbet,starz888
# Comma-separated plain hostnames (no scheme/port/path/wildcard), e.g. 1xlite-2781.pro. The server
# derives each site key with the same canonical rule as the extension (1xlite-2781.pro -> 1xlite-2781-pro).
ACCEPTED_SITE_DOMAINS=
# "statistical" = real descriptive statistics (production). "mock" returns labelled TEST DATA only.
ANALYSIS_PROVIDER=statistical
# Valid rounds per device/site before figures are shown as sufficiently supported (10-5000).
ANALYSIS_MIN_SAMPLE_SIZE=100
RETENTION_INTERVAL_SECONDS=300
SECURITY_EVENT_RETENTION_DAYS=90
# Optional image tag for the locally built aviator-backend / aviator-caddy images.
IMAGE_TAG=latest
