# ─────────────────────────────────────────────────────────────────────────────
# VPS backend configuration — PLACEHOLDERS ONLY.
# Copy to .env (never commit it). On the VPS: deploy/vps/.env, chmod 600.
# Generate each secret with:  openssl rand -base64 48
# The API refuses to start while any secret still starts with "change-me".
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
# Reverse-proxy addresses whose X-Forwarded-For is trusted (Docker: the Caddy container network).
TRUST_PROXY=false

# Local dev: printed by `npm run local-db`. On the VPS the host is the private Docker service name.
DATABASE_URL=postgres://aviator_app:change-me@127.0.0.1:55433/aviator_dev
DATABASE_POOL_MAX=10

# Four DIFFERENT random secrets, each >= 32 characters.
CODE_PEPPER=change-me-code-pepper-generate-with-openssl-rand
DEVICE_PEPPER=change-me-device-pepper-generate-with-openssl-rand
IP_HASH_PEPPER=change-me-ip-pepper-generate-with-openssl-rand
# Shared ONLY with the admin site's server runtime (Vercel env var VPS_ADMIN_SERVICE_KEY).
ADMIN_SERVICE_KEY=change-me-admin-service-key-generate-with-openssl-rand

# Device limit for NEW codes when the admin does not pick one (1-5). Existing codes keep theirs;
# raise them explicitly with: npm run db -- raise-device-limits --to 5 --apply
DEFAULT_DEVICE_LIMIT=5

CUSTOMER_SESSION_TTL_HOURS=168
ADMIN_SESSION_TTL_HOURS=8

# Site keys the API accepts history for.
# Use * to also accept sites found by the extension's generic detection (key = site domain,
# e.g. "example-casino-com"). Unlisted sites are rejected with a clear error in the extension.
# To run the extension's devfixture locally, append ",devfixture" below (development only —
# the server refuses to start in production if devfixture is listed).
ACCEPTED_SITE_IDS=onexbet,melbet,starz888
# Websites accepted by domain (plain hostnames, comma-separated, no wildcards). The server turns
# each into its site key with the same canonical rule as the extension, e.g.
# 1xlite-2781.pro -> 1xlite-2781-pro (the key shown in the popup).
ACCEPTED_SITE_DOMAINS=

ANALYSIS_PROVIDER=mock
# Valid rounds per device/site before figures are shown as sufficiently supported (10-5000).
ANALYSIS_MIN_SAMPLE_SIZE=100
RETENTION_INTERVAL_SECONDS=300
SECURITY_EVENT_RETENTION_DAYS=90
