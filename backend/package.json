{
  "name": "@aviator/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Private VPS API: activation, subscriptions, history ingestion, analysis interface, retention worker",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx --env-file=.env src/workers/retention-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/workers/retention-worker.js",
    "db": "tsx --env-file=.env src/database/cli.ts",
    "db:prod": "node dist/src/database/cli.js",
    "local-db": "node scripts/local-postgres.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "backtest": "tsx src/engine/backtest-cli.ts",
    "backtest:signal": "tsx src/engine/sequential/backtest.ts",
    "evaluate:signal": "tsx src/engine/sequential/evaluate.ts",
    "evaluate:strategy": "tsx src/engine/sequential/evaluate-strategy.ts"
  },
  "dependencies": {
    "@aviator/contracts": "0.1.0",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
